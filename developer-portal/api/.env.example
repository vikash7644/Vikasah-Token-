PORT=8787
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
# Replace both placeholders with real, non-zero, distinct deployed/public addresses.
VKT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VKT_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000
# Generate at least 32 bytes of cryptographically random secret material.
MERCHANT_API_KEY=replace-with-a-long-random-secret
MIN_CONFIRMATIONS=3
VERIFY_RATE_LIMIT_PER_MINUTE=120
# Comma-separated exact HTTPS origins; leave empty for server-to-server use only.
CORS_ALLOWED_ORIGINS=
# Use a persistent mounted disk path in hosted environments.
DATABASE_PATH=./vkt-payments.sqlite
# Optional: keep backups on persistent storage, then copy off-disk separately.
BACKUP_PATH=./backups/vkt-payments.sqlite
